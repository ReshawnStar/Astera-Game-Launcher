<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <OutputType>WinExe</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <AssemblyName>Astera</AssemblyName>
    <RootNamespace>Astera</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputPath Condition="'$(OutputPath)' == ''">bin\$(Configuration)\</OutputPath>
    <PowerShellExecutable Condition="'$(PowerShellExecutable)' == ''">pwsh</PowerShellExecutable>
    <StartAction>Program</StartAction>
    <StartProgram>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(OutputPath)', 'Astera.exe'))</StartProgram>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.Web.WebView2.Core"><HintPath>assets\vendor\webview2\Microsoft.Web.WebView2.Core.dll</HintPath></Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms"><HintPath>assets\vendor\webview2\Microsoft.Web.WebView2.WinForms.dll</HintPath></Reference>
    <Reference Include="YamlDotNet"><HintPath>assets\vendor\yamldotnet\YamlDotNet.dll</HintPath></Reference>
    <Compile Include="src\*.cs" />
    <Compile Include="$(OutputPath)*.g.cs" />
    <None Include="VERSION;app.manifest;app-release-notes.md;channel.public.xml;channel-settings.json" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- Build-Astera is the single resource/dependency/updater build specification.
       The old independent project resource list had drifted behind the real app. -->
  <Target Name="Build">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
      Command="&quot;$(PowerShellExecutable)&quot; -NoProfile -File &quot;$(MSBuildProjectDirectory)\scripts\Build-Astera.ps1&quot; -OutputDirectory &quot;$(OutputPath)&quot;" />
  </Target>
</Project>
